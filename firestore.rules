rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['directivo', 'secretario', 'admin', 'administrador', 'DIRECTIVO', 'SECRETARIO', 'ADMIN'];
    }

    function isCoach() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['dt', 'DT', 'profesor', 'entrenador', 'coach', 'Profesor', 'Entrenador'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.role == 'jugador' || isAdmin());
      allow update: if isOwner(userId) || isAdmin() || isCoach() || (isAuthenticated() && resource.data.get('role', '') == 'jugador');
      allow delete: if isAdmin();
    }

    // ─── Inbox / Messages ───
    match /inbox_threads/{threadId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ─── Player Tutor Links ───
    match /player_tutor_links/{linkId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.tutorId == request.auth.uid ||
        isAdmin() ||
        isCoach()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.tutorId == request.auth.uid ||
        isAdmin() ||
        isCoach()
      );
    }

    // ─── Store Products ───
    match /store_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Store Orders ───
    match /store_orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.playerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Settings & Config ───
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /support_inquiries/{inquiryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }


    // ─── Events & Announcements ───
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Payments ───
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Novedades ───
    match /novedades/{novedadId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isCoach();
      allow update: if isAdmin() || isCoach() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'seenBy', 'read', 'seen', 'updatedAt'])
      );
    }

    // ─── Sponsors ───
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Clubs & Categories ───
    match /clubs/{clubId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() || (
        isAuthenticated() &&
        categoryId.matches('^[0-9]{4}$') &&
        request.resource.data.name.matches('^[0-9]{4}$')
      );
      allow delete: if isAdmin();
    }

    // ─── Match & Sports Domain ───
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
      
      match /convocatoria/{playerId} {
        allow read, write: if isAuthenticated();
      }
      match /lineup/{playerId} {
        allow read: if true;
        allow write: if isAdmin() || isCoach();
      }
    }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /league_reports/{reportId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /coach_reports/{reportId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /scorers/{scorerId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /training_schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /match_lineups/{lineupId} {
      allow read: if true;
      allow write: if isAdmin() || isCoach();
    }

    match /birthday_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /tutor_convocatorias/{convId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /league_jornadas/{jornadaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─── Default: deny everything else ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['directivo', 'secretario'];
    }

    // ─── Public & Store Product Images ───
    match /store_products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Store Receipt Images ───
    match /store_receipts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }

    // ─── Avatars, Sponsors & Novedades ───
    match /avatars/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /sponsors/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /novedades/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Fallback for other images ───
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
